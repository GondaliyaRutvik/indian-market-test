# ---------------------------------------------------------------------------
# 1. DATABASE (required)
# Free Postgres: https://neon.tech  or  https://supabase.com
# Neon gives you a string that already ends with ?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# 2. APP LOGIN (required when deployed — this app is public on the internet)
# Any password you like. You will type it once and stay logged in for 30 days.
# ---------------------------------------------------------------------------
APP_PASSWORD="change-me-to-something-long"

# ---------------------------------------------------------------------------
# 3. CRON SECRET (required)
# Random string. The /api/cron/check endpoint refuses to run without it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ---------------------------------------------------------------------------
CRON_SECRET="change-me-random-hex"

# ---------------------------------------------------------------------------
# 4. TELEGRAM (optional — can also be set in the app's Settings page)
# Steps: open Telegram -> talk to @BotFather -> /newbot -> copy the token.
# Then message your new bot once, and open:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# to find your numeric chat id.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------------------------------------------------------------------------
# 5. EMAIL (optional) — pick ONE of the two options below
# ---------------------------------------------------------------------------
# Option A: Resend (easiest, no SMTP). Free 3000 emails/month. https://resend.com
RESEND_API_KEY=""
# Must be a domain you verified in Resend, or use onboarding@resend.dev for testing
EMAIL_FROM="Nifty Alerts <onboarding@resend.dev>"

# Option B: Gmail / any SMTP. For Gmail create an "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Where alert emails are delivered
EMAIL_TO=""
