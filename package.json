{
  "name": "nifty-dip-alerts",
  "version": "1.0.0",
  "private": true,
  "description": "Indian market index tracker with dip alerts (Telegram / Email / in-app) and ETF buy suggestions",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "node scripts/seed.mjs",
    "check": "node scripts/run-check.mjs",
    "test": "tsc -p tsconfig.test.json && node node_modules/.test-build/scripts/engine.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "next": "^15.1.6",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.3",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.0.3",
    "typescript": "^5.7.3"
  }
}
